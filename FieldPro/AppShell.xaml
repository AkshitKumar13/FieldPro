<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="FieldPro.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FieldPro.Views">

    <!-- Login -->
    <ShellContent
        Route="Login"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Main application -->
    <FlyoutItem
        Title="FieldPro"
        Route="Main">

        <ShellContent
            Title="Dashboard"
            Route="Dashboard"
            ContentTemplate="{DataTemplate views:DashboardPage}" />

    </FlyoutItem>

    <MenuItem
        Text="Logout"
        Clicked="OnLogoutClicked" />

    <MenuItem
        Text="Reseed DB (Dev)"
        Clicked="OnReseedClicked" />

</Shell>
