<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="TaskForge.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TaskForge.Views">

    <!-- Login -->
    <ShellContent
        Route="Login"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Main application -->
    <FlyoutItem
        Title="TaskForge"
        Route="Main">

        <ShellContent
            Title="Dashboard"
            Route="Dashboard"
            ContentTemplate="{DataTemplate views:DashboardPage}" />

        <ShellContent Title="Tasks" Route="Tasks" ContentTemplate="{DataTemplate views:TasksPage}" />
        <ShellContent Title="Projects" Route="Projects" ContentTemplate="{DataTemplate views:ProjectsPage}" />
        <ShellContent Title="Team" Route="Team" ContentTemplate="{DataTemplate views:TeamPage}" />
        <ShellContent Title="Notifications" Route="Notifications" ContentTemplate="{DataTemplate views:NotificationsPage}" />
        <ShellContent Title="Documents" Route="Documents" ContentTemplate="{DataTemplate views:DocumentsPage}" />
        <ShellContent Title="Profile" Route="Profile" ContentTemplate="{DataTemplate views:ProfilePage}" />

    </FlyoutItem>

    <MenuItem
        Text="Logout"
        Clicked="OnLogoutClicked" />

    <MenuItem
        Text="Reseed DB (Dev)"
        Clicked="OnReseedClicked" />

</Shell>
