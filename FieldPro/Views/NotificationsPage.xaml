<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="TaskForge.Views.NotificationsPage" Title="Notifications">
	<CollectionView ItemsSource="{Binding Items}" Margin="20">
		<CollectionView.ItemTemplate>
			<DataTemplate>
				<Border Padding="14" Margin="0,0,0,10" Stroke="#D9E1E8">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnNotificationTapped" />
					</Border.GestureRecognizers>
					<VerticalStackLayout>
						<Label Text="{Binding Title}" FontAttributes="Bold" />
						<Label Text="{Binding Message}" />
						<Label Text="{Binding IsRead, StringFormat='Read: {0}'}" TextColor="#5F6B7A" />
					</VerticalStackLayout>
				</Border>
			</DataTemplate>
		</CollectionView.ItemTemplate>
	</CollectionView>
</ContentPage>