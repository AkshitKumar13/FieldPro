<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FieldPro.Views.DashboardPage"
    Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <!-- Welcome -->
            <VerticalStackLayout Spacing="4">

                <Label
                    Text="Welcome back!"
                    FontSize="16"
                    Opacity="0.7" />

                <Label
                    Text="FieldPro Dashboard"
                    FontSize="28"
                    FontAttributes="Bold" />

                <Label
                    Text="Manage your field operations"
                    FontSize="14"
                    Opacity="0.7" />

            </VerticalStackLayout>


            <!-- Summary -->
            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

                <!-- Open Work Orders -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOpenWorkOrdersTapped" />
                    </Border.GestureRecognizers>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="Open Work Orders"
                            FontSize="13"
                            Opacity="0.7" />

                        <Label
                            Text="{Binding OpenCount}"
                            FontSize="28"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Border>


                <!-- Pending -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="15">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPendingTapped" />
                    </Border.GestureRecognizers>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="Pending"
                            FontSize="13"
                            Opacity="0.7" />

                        <Label
                            Text="{Binding PendingCount}"
                            FontSize="28"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Border>


                <!-- Completed -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="15">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCompletedTapped" />
                    </Border.GestureRecognizers>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="Completed"
                            FontSize="13"
                            Opacity="0.7" />

                        <Label
                            Text="{Binding CompletedCount}"
                            FontSize="28"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Border>


                <!-- System Status -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="15">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSystemStatusTapped" />
                    </Border.GestureRecognizers>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="System Status"
                            FontSize="13"
                            Opacity="0.7" />

                        <Label
                            Text="{Binding SystemStatus}"
                            FontSize="22"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Border>

            </Grid>


            <!-- Work Orders section removed as requested -->


            <!-- Quick Actions removed -->


            <!-- Connectivity -->
            <Border
                Padding="15">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout>

                        <Label
                            Text="Connectivity"
                            FontSize="14"
                            FontAttributes="Bold" />

                        <Label
                            Text="Connected to server"
                            FontSize="13"
                            Opacity="0.7" />

                    </VerticalStackLayout>

                    <Label
                        Grid.Column="1"
                        Text="● Online"
                        VerticalOptions="Center"
                        FontAttributes="Bold" />

                </Grid>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>