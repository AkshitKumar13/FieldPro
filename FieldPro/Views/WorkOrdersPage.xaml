<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FieldPro.Views.WorkOrdersPage"
    Title="Work Orders">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="20,15"
            Spacing="5">

            <Label
                Text="Work Orders"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Manage your assigned field jobs"
                FontSize="14"
                Opacity="0.7" />

        </VerticalStackLayout>

        <!-- Content -->
        <RefreshView
            Grid.Row="1"
            IsRefreshing="{Binding IsBusy}"
            Command="{Binding LoadWorkOrdersCommand}">
            <CollectionView
                ItemsSource="{Binding WorkOrders}"
                SelectionMode="Single"
                SelectionChangedCommand="{Binding WorkOrderSelectedCommand}"
                SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="30"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">

                        <Label
                            Text="No work orders found"
                            FontSize="18"
                            HorizontalOptions="Center" />

                        <Label
                            Text="Pull down to refresh"
                            FontSize="14"
                            Opacity="0.6"
                            HorizontalOptions="Center" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="15,5"
                            Padding="15"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Grid
                                    ColumnDefinitions="*,Auto">

                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding Title}"
                                        FontSize="18"
                                        FontAttributes="Bold" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Priority}"
                                        FontSize="13"
                                        FontAttributes="Bold" />

                                </Grid>

                                <Label
                                    Text="{Binding CustomerName}"
                                    FontSize="15" />

                                <Label
                                    Text="{Binding Address}"
                                    FontSize="13"
                                    Opacity="0.7" />

                                <Grid
                                    ColumnDefinitions="*,Auto">

                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding Status}"
                                        FontSize="14" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding ScheduledDate, StringFormat='{0:dd MMM yyyy HH:mm}'}"
                                        FontSize="13"
                                        Opacity="0.7" />

                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

        <!-- Loading -->
        <ActivityIndicator
            Grid.RowSpan="2"
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

    </Grid>

</ContentPage>