<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TaskForge.Views.LoginPage"
    Title="Login">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="TaskForge"
                FontSize="36"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Enterprise Field Service Platform"
                FontSize="16"
                HorizontalOptions="Center" />

            <Picker Title="Choose a demo user" ItemsSource="{Binding Users}" ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedUser}" />

            <Button
                Text="Login"
                Command="{Binding LoginCommand}" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red"
                IsVisible="{Binding HasError}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>