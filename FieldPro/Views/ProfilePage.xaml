<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ContosoDashboard.Views.ProfilePage" Title="Profile"><ScrollView><VerticalStackLayout Padding="24" Spacing="12"><Label Text="Your profile" FontSize="26" FontAttributes="Bold"/><Entry Text="{Binding CurrentUser.DisplayName}" Placeholder="Display name"/><Label Text="{Binding CurrentUser.Email}"/><Label Text="{Binding CurrentUser.JobTitle}"/><Label Text="{Binding CurrentUser.Department}"/><Label Text="{Binding CurrentUser.Role}"/><Button Text="Save profile" Clicked="OnSaveClicked"/></VerticalStackLayout></ScrollView></ContentPage>