<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="TaskForge.Views.DocumentsPage" Title="Documents"><CollectionView ItemsSource="{Binding Items}" Margin="20"><CollectionView.ItemTemplate><DataTemplate><Border Padding="14" Margin="0,0,0,10" Stroke="#D9E1E8"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold"/><Label Text="{Binding OriginalFileName}"/><Label Text="{Binding Category}" TextColor="#5F6B7A"/></VerticalStackLayout><Button Grid.Column="1" Text="Open PDF" Clicked="OnOpenDocumentClicked" CommandParameter="{Binding .}" VerticalOptions="Center" Padding="12,8"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></ContentPage>