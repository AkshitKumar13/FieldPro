<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ContosoDashboard.Views.TeamPage" Title="Team"><CollectionView ItemsSource="{Binding Items}" Margin="20"><CollectionView.ItemTemplate><DataTemplate><Border Padding="14" Margin="0,0,0,10" Stroke="#D9E1E8"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding DisplayName}" FontSize="17" FontAttributes="Bold"/><Label Text="{Binding JobTitle}"/><Label Text="{Binding Department}" TextColor="#5F6B7A"/></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Role}" VerticalOptions="Center"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></ContentPage>